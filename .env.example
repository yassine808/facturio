# Copy to .env.local (never commit .env.local — only this file).
# Validated at startup by src/lib/env.ts.

# Supabase (Dashboard → Project Settings → API, or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key

# Base URL of the app (used for auth email/OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase SECRET key (Dashboard → Project Settings → API). Used only by the
# Stripe webhook handler (src/lib/supabase/service-role.ts) — never by pages
# or actions, which must keep going through RLS.
SUPABASE_SECRET_KEY=replace-with-sk_-secret-key

# Stripe (Phase 4) — both OPTIONAL: without them the app runs in documented
# "billing disabled" mode (upgrade/manage buttons hidden, nothing else fails).
# STRIPE_SECRET_KEY: Dashboard → Developers → API keys (test mode).
# STRIPE_WEBHOOK_SECRET: whsec_… from `stripe listen` or the Dashboard endpoint.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
